  Serial.println(F("9 - Dispense ALL 3 simultaneously (mL)"));
  Serial.println(F("0 - Stop all outputs"));
  Serial.println(F("======================================="));
  Serial.print(F("Enter choice: "));
}

void processSerialCommand(int cmd) {
  switch (cmd) {
    case 1:
      printAllWeights();
      break;

    case 2: {
      Serial.print(F("Select container to tare (1-3): "));
      int c = readIntBlocking();
      tareContainer((uint8_t)c);
      break;
    }

    case 3:
      tareAll();
      break;

    case 4: {
      Serial.print(F("Select container to calibrate (1-3): "));
      int c = readIntBlocking();
      Serial.print(F("Place known weight and enter value (g): "));
      float known = readFloatBlocking();
      calibrateContainer((uint8_t)c, known);
      break;
    }

    case 5:
      showConfig();
      break;

    case 9: {
      Serial.println(F("Enter mL for container1 (C1): "));
      float m1 = readFloatBlocking();

      Serial.println(F("Enter mL for container2 (C2): "));
      float m2 = readFloatBlocking();

      Serial.println(F("Enter mL for container3 (C3) (ignored; C3=C2): "));
      float m3 = readFloatBlocking();

      String manualId = String("manual_") + String(millis());
      RunResult result = runDispenseJob(m1, m2, m3, manualId);

      Serial.print(F("[Manual] Final status: "));
      Serial.println(result.finalStatus);
      if (result.logId.length()) {
        Serial.print(F("[Manual] Log ID: "));
        Serial.println(result.logId);
      }
      break;
    }

    case 0:
      stopAllOutputs();
      Serial.println(F("All outputs OFF"));
      break;

    default:
      Serial.println(F("Invalid choice"));
      break;
  }
}

// ============================================================
// SETUP / LOOP
// ============================================================
void setup() {
  Serial.begin(SERIAL_BAUD);
  delay(1500);

  pinMode(PUMP1_PIN, OUTPUT);
  pinMode(PUMP2_PIN, OUTPUT);
  pinMode(PUMP3_PIN, OUTPUT);
  pinMode(SOL1_PIN, OUTPUT);
  pinMode(SOL2_PIN, OUTPUT);
  pinMode(SOL3_PIN, OUTPUT);

  stopAllOutputs();

  lc1.begin(LC1_DT, LC1_SCK);
  lc2.begin(LC2_DT, LC2_SCK);
  lc3.begin(LC3_DT, LC3_SCK);

  loadConfig();

  connectWiFi();

  if (firebaseAnonymousSignIn()) {
    Serial.println(F("[Setup] Firebase ready"));
  } else {
    Serial.println(F("[Setup] Firebase sign-in failed"));
  }

  syncTime();

  gDeviceBusy = false;
  gDeviceState = "IDLE";
  gLastExecutionStatus = "";
  updateDeviceStatusDocument();
  gLastHeartbeatMs = millis();

  Serial.println(F("\nSystem ready"));
  Serial.println(F("Open Serial Monitor at 115200"));

  showMenu();
  gMenuShown = true;
}

void loop() {
  unsigned long now = millis();

  if (now - gLastCommandPollMs >= COMMAND_POLL_INTERVAL_MS) {
    gLastCommandPollMs = now;
    pollAndHandleCloudCommand();
  }

  if (now - gLastHeartbeatMs >= STATUS_HEARTBEAT_MS) {
    gLastHeartbeatMs = now;
    updateDeviceStatusDocument();
  }

  if (!gMenuShown) {
    showMenu();
    gMenuShown = true;
  }

  if (Serial.available()) {
    int cmd = readIntBlocking();
    processSerialCommand(cmd);
    gMenuShown = false;
  }

  delay(50);
}

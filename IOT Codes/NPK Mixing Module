void connectWiFi() {
  if (WiFi.status() == WL_CONNECTED) return;

  Serial.println(F("Connecting to WiFi..."));
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  delay(300);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  unsigned long t0 = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t0 < 20000UL) {
    Serial.print(".");
    delay(300);
  }
  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println(F("WiFi connected"));
    Serial.print(F("IP: "));
    Serial.println(WiFi.localIP());
  } else {
    Serial.println(F("WiFi connect failed"));
  }
}

void syncTime() {
  if (WiFi.status() != WL_CONNECTED) return;

  Serial.println(F("Syncing time..."));
  configTime(0, 0, NTP_SERVER_1, NTP_SERVER_2);

  unsigned long t0 = millis();
  while (millis() - t0 < 15000UL) {
    time_t now = time(nullptr);
    if (now >= MIN_VALID_EPOCH) {
      timeSynced = true;
      Serial.println(F("Time synced"));
      return;
    }
    Serial.print(".");
    delay(300);
  }
  Serial.println();
  Serial.println(F("Time sync failed, using uptime fallback"));
  timeSynced = false;
}

String makeUtcTimestamp() {
  time_t now = time(nullptr);
  if (now >= MIN_VALID_EPOCH) {
    struct tm tmUtc;
    gmtime_r(&now, &tmUtc);
    char buf[25];
    snprintf(
      buf, sizeof(buf),
      "%04d-%02d-%02dT%02d:%02d:%02dZ",
      tmUtc.tm_year + 1900,
      tmUtc.tm_mon + 1,
      tmUtc.tm_mday,
      tmUtc.tm_hour,
      tmUtc.tm_min,
      tmUtc.tm_sec
    );
    return String(buf);
  }
  return String("uptime_") + String(millis());
}

uint64_t makeLastSeenEpochMs() {
  time_t now = time(nullptr);
  if (now >= MIN_VALID_EPOCH) {
    return ((uint64_t)now) * 1000ULL;
  }
  return 0ULL;
}

String makeLogDocId() {
  time_t now = time(nullptr);
  if (now >= MIN_VALID_EPOCH) {
    struct tm tmUtc;
    gmtime_r(&now, &tmUtc);
    char buf[48];
    snprintf(
      buf, sizeof(buf),
      "log_%04d%02d%02d_%02d%02d%02d_%lu",
      tmUtc.tm_year + 1900,
      tmUtc.tm_mon + 1,
      tmUtc.tm_mday,
      tmUtc.tm_hour,
      tmUtc.tm_min,
      tmUtc.tm_sec,
      (unsigned long)millis()
    );
    return String(buf);
  }
  return String("log_uptime_") + String(millis());
}

// ============================================================
// FIRESTORE FIELD PARSERS
// ============================================================
String fsGetString(JsonObject fields, const char *key) {
  if (fields[key].isNull()) return "";
  JsonVariant v = fields[key];

  if (!v["stringValue"].isNull()) {
    const char *s = v["stringValue"];
    return s ? String(s) : "";
  }
  if (!v["integerValue"].isNull()) {
    const char *s = v["integerValue"];
    return s ? String(s) : "";
  }
  if (!v["doubleValue"].isNull()) {
    return String(v["doubleValue"].as<double>(), 6);
  }
  if (!v["booleanValue"].isNull()) {
    return v["booleanValue"].as<bool>() ? "true" : "false";
  }
  return "";
}

double fsGetDouble(JsonObject fields, const char *key, double defaultValue = 0.0) {
  if (fields[key].isNull()) return defaultValue;
  JsonVariant v = fields[key];

  if (!v["doubleValue"].isNull()) {
    return v["doubleValue"].as<double>();
  }
  if (!v["integerValue"].isNull()) {
    const char *s = v["integerValue"];
    return s ? atof(s) : defaultValue;
  }
  if (!v["stringValue"].isNull()) {
    const char *s = v["stringValue"];
    return s ? atof(s) : defaultValue;
  }
  return defaultValue;
}

bool fsGetBool(JsonObject fields, const char *key, bool defaultValue = false) {
  if (fields[key].isNull()) return defaultValue;
  JsonVariant v = fields[key];
  if (!v["booleanValue"].isNull()) return v["booleanValue"].as<bool>();
  if (!v["stringValue"].isNull()) {
    String s = String((const char*)v["stringValue"]);
    s.toLowerCase();
    return s == "true";
  }
  return defaultValue;
}

// ============================================================
// HTTP REQUEST
// ============================================================
bool httpRequest(const String &method,
                 const String &url,
                 const String &contentType,
                 const String &payload,
                 const String &bearerToken,
                 int &httpCode,
                 String &responseBody) {
  if (WiFi.status() != WL_CONNECTED) {
    httpCode = -1;
    responseBody = "WiFi not connected";
    return false;
  }

  WiFiClientSecure client;
  client.setInsecure();

  HTTPClient http;
  http.setTimeout(15000);

  if (!http.begin(client, url)) {
    httpCode = -2;
    responseBody = "http.begin failed";
    return false;
  }

  if (contentType.length()) {
    http.addHeader("Content-Type", contentType);
  }

  if (bearerToken.length()) {
    http.addHeader("Authorization", "Bearer " + bearerToken);
  }

  if (method == "GET") {
    httpCode = http.GET();
  } else if (method == "POST") {
    httpCode = http.POST(payload);
  } else if (method == "PATCH") {
    httpCode = http.sendRequest("PATCH", payload);
  } else {
    http.end();
    httpCode = -3;
    responseBody = "unsupported method";
    return false;
  }

  responseBody = http.getString();
  http.end();
  return true;
}

// ============================================================
// FIREBASE AUTH
// ============================================================
bool firebaseAnonymousSignIn() {
  int code = 0;
  String resp;

  String url = String("https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=") + API_KEY;
  String payload = "{\"returnSecureToken\":true}";

  bool ok = httpRequest("POST", url, "application/json", payload, "", code, resp);

  Serial.print(F("[Auth] HTTP: "));
  Serial.println(code);
  Serial.println(resp);

  if (!ok || code < 200 || code >= 300) {
    fbSignedIn = false;
    return false;
  }

  JsonDocument doc;
  DeserializationError err = deserializeJson(doc, resp);
  if (err) {
    Serial.print(F("[Auth] JSON parse failed: "));
    Serial.println(err.c_str());
    fbSignedIn = false;
    return false;
  }

  fbIdToken = doc["idToken"] | "";
  fbRefreshToken = doc["refreshToken"] | "";
  fbUid = doc["localId"] | "";
  unsigned long expiresSec = strtoul((doc["expiresIn"] | "3600"), nullptr, 10);

  fbTokenExpireAtMs = millis() + expiresSec * 1000UL;
  fbSignedIn = fbIdToken.length() > 0;

  return fbSignedIn;
}

bool firebaseRefreshToken() {
  if (!fbRefreshToken.length()) return false;

  int code = 0;
  String resp;

  String url = String("https://securetoken.googleapis.com/v1/token?key=") + API_KEY;
  String payload = String("grant_type=refresh_token&refresh_token=") + fbRefreshToken;

  bool ok = httpRequest("POST", url, "application/x-www-form-urlencoded", payload, "", code, resp);

  Serial.print(F("[Refresh] HTTP: "));
  Serial.println(code);
  Serial.println(resp);

  if (!ok || code < 200 || code >= 300) {
    fbSignedIn = false;
    return false;
  }

  JsonDocument doc;
  DeserializationError err = deserializeJson(doc, resp);
  if (err) {
    Serial.print(F("[Refresh] JSON parse failed: "));
    Serial.println(err.c_str());
    fbSignedIn = false;
    return false;
  }

  fbIdToken = doc["id_token"] | "";
  fbRefreshToken = doc["refresh_token"] | fbRefreshToken;
  fbUid = doc["user_id"] | fbUid;
  unsigned long expiresSec = strtoul((doc["expires_in"] | "3600"), nullptr, 10);

  fbTokenExpireAtMs = millis() + expiresSec * 1000UL;
  fbSignedIn = fbIdToken.length() > 0;

  return fbSignedIn;
}

bool firebaseEnsureReady() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println(F("[Firebase] WiFi lost, reconnecting..."));
    connectWiFi();
  }

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println(F("[Firebase] WiFi still not connected"));
    return false;
  }

  if (!fbSignedIn || fbIdToken.length() == 0) {
    Serial.println(F("[Firebase] Signing in..."));
    if (!firebaseAnonymousSignIn()) return false;
  }

  if (millis() + 300000UL >= fbTokenExpireAtMs) {
    Serial.println(F("[Firebase] Refreshing token..."));
    if (!firebaseRefreshToken()) return false;
  }

  if (!timeSynced) {
    syncTime();
  }

  return true;
}

// ============================================================
// FIRESTORE STATUS DOC
// ============================================================
bool updateDeviceStatusDocument() {
  if (!firebaseEnsureReady()) {
    Serial.println(F("[Status] Firebase not ready"));
    return false;
  }

  uint64_t lastSeenEpochMs = makeLastSeenEpochMs();

  JsonDocument doc;
  JsonObject fields = doc["fields"].to<JsonObject>();

  fields["deviceId"]["stringValue"] = DEVICE_ID;
  fields["online"]["booleanValue"] = (WiFi.status() == WL_CONNECTED);

  fields["busy"]["booleanValue"] = gDeviceBusy;
  fields["state"]["stringValue"] = gDeviceState;
  fields["lastCommandId"]["stringValue"] = gLastCommandId;
  fields["lastLogId"]["stringValue"] = gLastLogId;
  fields["lastExecutionStatus"]["stringValue"] = gLastExecutionStatus;
  fields["updatedAt"]["stringValue"] = makeUtcTimestamp();

  fields["lastSeenEpochMs"]["integerValue"] = uint64ToString(lastSeenEpochMs);
  fields["offlineTimeoutMs"]["integerValue"] = String((unsigned long)DEVICE_OFFLINE_TIMEOUT_MS);

  fields["wifiConnected"]["booleanValue"] = (WiFi.status() == WL_CONNECTED);
  fields["timeSynced"]["booleanValue"] = timeSynced;

  String payload;
  serializeJson(doc, payload);

  String url = String("https://firestore.googleapis.com/v1/projects/") +
               FIREBASE_PROJECT_ID +
               "/databases/(default)/documents/deviceStatus/" +
               DEVICE_ID;

  int code = 0;
  String resp;
  bool ok = httpRequest("PATCH", url, "application/json", payload, fbIdToken, code, resp);

  Serial.print(F("[Status] HTTP: "));
  Serial.println(code);

  if (code == 401) {
    Serial.println(F("[Status] Token expired/invalid, retrying once..."));
    fbSignedIn = false;
    if (!firebaseEnsureReady()) return false;

    ok = httpRequest("PATCH", url, "application/json", payload, fbIdToken, code, resp);
    Serial.print(F("[Status retry] HTTP: "));
    Serial.println(code);
  }

  return ok && code >= 200 && code < 300;
}

// ============================================================
// FIRESTORE COMMAND DOC
// ============================================================
bool fetchDeviceCommand(DeviceCommand &cmd) {
  cmd = DeviceCommand();

  if (!firebaseEnsureReady()) {
    Serial.println(F("[Command] Firebase not ready"));
    return false;
  }

  String url = String("https://firestore.googleapis.com/v1/projects/") +
               FIREBASE_PROJECT_ID +
               "/databases/(default)/documents/deviceCommands/" +
               DEVICE_ID;

  int code = 0;
  String resp;
  bool ok = httpRequest("GET", url, "", "", fbIdToken, code, resp);

  if (code == 401) {
    Serial.println(F("[Command] Token expired/invalid, retrying once..."));
    fbSignedIn = false;
    if (!firebaseEnsureReady()) return false;
    ok = httpRequest("GET", url, "", "", fbIdToken, code, resp);
  }

  if (code == 404) {
    return true;
  }

  if (!ok || code < 200 || code >= 300) {
    Serial.print(F("[Command] Fetch failed HTTP "));
    Serial.println(code);
    Serial.println(resp);
    return false;
  }

  JsonDocument doc;
  DeserializationError err = deserializeJson(doc, resp);
  if (err) {
    Serial.print(F("[Command] JSON parse failed: "));
    Serial.println(err.c_str());
    return false;
  }

  JsonObject fields = doc["fields"].as<JsonObject>();
  if (fields.isNull()) return true;

  cmd.exists = true;
  cmd.commandId = fsGetString(fields, "commandId");
  cmd.type = fsGetString(fields, "type");
  cmd.c1ml = fsGetDouble(fields, "c1ml", 0.0);
  cmd.c2ml = fsGetDouble(fields, "c2ml", 0.0);
  cmd.c3ml = fsGetDouble(fields, "c3ml", 0.0);
  cmd.status = fsGetString(fields, "status");
  cmd.requestedBy = fsGetString(fields, "requestedBy");
  cmd.requestedAt = fsGetString(fields, "requestedAt");
  cmd.lastUpdatedAt = fsGetString(fields, "lastUpdatedAt");
  cmd.startedAt = fsGetString(fields, "startedAt");
  cmd.completedAt = fsGetString(fields, "completedAt");
  cmd.executionStatus = fsGetString(fields, "executionStatus");
  cmd.lastLogId = fsGetString(fields, "lastLogId");

  return true;
}

bool updateDeviceCommandDocument(const DeviceCommand &cmd) {
  if (!firebaseEnsureReady()) {
    Serial.println(F("[Command] Firebase not ready"));
    return false;
  }

  JsonDocument doc;
  JsonObject fields = doc["fields"].to<JsonObject>();

  fields["deviceId"]["stringValue"] = DEVICE_ID;
  fields["commandId"]["stringValue"] = cmd.commandId;
  fields["type"]["stringValue"] = cmd.type;
  fields["c1ml"]["doubleValue"] = cmd.c1ml;
  fields["c2ml"]["doubleValue"] = cmd.c2ml;
  fields["c3ml"]["doubleValue"] = cmd.c3ml;
  fields["status"]["stringValue"] = cmd.status;
  fields["requestedBy"]["stringValue"] = cmd.requestedBy;
  fields["requestedAt"]["stringValue"] = cmd.requestedAt;
  fields["lastUpdatedAt"]["stringValue"] = cmd.lastUpdatedAt;
  fields["startedAt"]["stringValue"] = cmd.startedAt;
  fields["completedAt"]["stringValue"] = cmd.completedAt;
  fields["executionStatus"]["stringValue"] = cmd.executionStatus;
  fields["lastLogId"]["stringValue"] = cmd.lastLogId;
  fields["handledByDeviceId"]["stringValue"] = DEVICE_ID;
  fields["handledByUid"]["stringValue"] = fbUid;

  String payload;
  serializeJson(doc, payload);

  String url = String("https://firestore.googleapis.com/v1/projects/") +
               FIREBASE_PROJECT_ID +
               "/databases/(default)/documents/deviceCommands/" +
               DEVICE_ID;

  int code = 0;
  String resp;
  bool ok = httpRequest("PATCH", url, "application/json", payload, fbIdToken, code, resp);

  Serial.print(F("[Command update] HTTP: "));
  Serial.println(code);

  if (code == 401) {
    Serial.println(F("[Command update] Token expired/invalid, retrying once..."));
    fbSignedIn = false;
    if (!firebaseEnsureReady()) return false;

    ok = httpRequest("PATCH", url, "application/json", payload, fbIdToken, code, resp);
    Serial.print(F("[Command update retry] HTTP: "));
    Serial.println(code);
  }

  return ok && code >= 200 && code < 300;
}

// ============================================================
// FIRESTORE LOG WRITE
// ============================================================
bool addDispenseLogToFirestore(float inputMl1,
                               float inputMl2,
                               float inputMl3User,
                               float usedMl3,
                               float target1g,
                               float target2g,
                               bool startOk1,
                               bool startOk2,
                               bool startOk3,
                               float startW1,
                               float startW2,
                               float startW3,
                               bool endOk1,
                               bool endOk2,
                               bool endOk3,
                               float endW1,
                               float endW2,
                               float endW3,
                               const String &status,
                               String &outDocId) {
  if (!firebaseEnsureReady()) {
    Serial.println(F("[Firestore] Firebase not ready"));
    return false;
  }

  outDocId = makeLogDocId();
  String timestampUtc = makeUtcTimestamp();
  time_t now = time(nullptr);
  long epochSeconds = (now >= MIN_VALID_EPOCH) ? (long)now : -1;

  JsonDocument doc;
  JsonObject fields = doc["fields"].to<JsonObject>();

  fields["logId"]["stringValue"] = outDocId;
  fields["deviceId"]["stringValue"] = DEVICE_ID;
  fields["status"]["stringValue"] = status;
  fields["uid"]["stringValue"] = fbUid;
  fields["commandId"]["stringValue"] = gLastCommandId;

  fields["timestampUtc"]["stringValue"] = timestampUtc;
  fields["epochSeconds"]["integerValue"] = String(epochSeconds);
  fields["deviceMillis"]["integerValue"] = String(millis());

  fields["inputMl1"]["doubleValue"] = inputMl1;
  fields["inputMl2"]["doubleValue"] = inputMl2;
  fields["inputMl3User"]["doubleValue"] = inputMl3User;
  fields["usedMl3"]["doubleValue"] = usedMl3;

  fields["target1g"]["doubleValue"] = target1g;
  fields["target2g"]["doubleValue"] = target2g;

  fields["startWeight1Ok"]["booleanValue"] = startOk1;
  fields["startWeight2Ok"]["booleanValue"] = startOk2;
  fields["startWeight3Ok"]["booleanValue"] = startOk3;

  fields["startWeight1"]["doubleValue"] = startOk1 ? startW1 : 0.0;
  fields["startWeight2"]["doubleValue"] = startOk2 ? startW2 : 0.0;
  fields["startWeight3"]["doubleValue"] = startOk3 ? startW3 : 0.0;

  fields["endWeight1Ok"]["booleanValue"] = endOk1;
  fields["endWeight2Ok"]["booleanValue"] = endOk2;
  fields["endWeight3Ok"]["booleanValue"] = endOk3;

  fields["endWeight1"]["doubleValue"] = endOk1 ? endW1 : 0.0;
  fields["endWeight2"]["doubleValue"] = endOk2 ? endW2 : 0.0;
  fields["endWeight3"]["doubleValue"] = endOk3 ? endW3 : 0.0;

  fields["wifiConnected"]["booleanValue"] = (WiFi.status() == WL_CONNECTED);
  fields["timeSynced"]["booleanValue"] = timeSynced;

  String payload;
  serializeJson(doc, payload);

  String url = String("https://firestore.googleapis.com/v1/projects/") +
               FIREBASE_PROJECT_ID +
               "/databases/(default)/documents/dispenseLogs/" +
               outDocId;

  int code = 0;
  String resp;
  bool ok = httpRequest("PATCH", url, "application/json", payload, fbIdToken, code, resp);

  Serial.print(F("[Firestore] HTTP: "));
  Serial.println(code);

  if (code == 401) {
    Serial.println(F("[Firestore] Token expired/invalid, retrying once..."));
    fbSignedIn = false;

    if (!firebaseEnsureReady()) return false;

    ok = httpRequest("PATCH", url, "application/json", payload, fbIdToken, code, resp);
    Serial.print(F("[Firestore retry] HTTP: "));
    Serial.println(code);
  }

  return ok && code >= 200 && code < 300;
}


HX711* getLoadCell(uint8_t container) {
  switch (container) {
    case 1: return &lc1;
    case 2: return &lc2;
    case 3: return &lc3;
    default: return nullptr;
  }
}

long getOffset(uint8_t container) {
  switch (container) {
    case 1: return cfg.offset1;
    case 2: return cfg.offset2;
    case 3: return cfg.offset3;
    default: return 0L;
  }
}

void setOffset(uint8_t container, long value) {
  switch (container) {
    case 1: cfg.offset1 = value; break;
    case 2: cfg.offset2 = value; break;
    case 3: cfg.offset3 = value; break;
  }
}

float getScale(uint8_t container) {
  switch (container) {
    case 1: return cfg.scale1;
    case 2: return cfg.scale2;
    case 3: return cfg.scale3;
    default: return 1.0f;
  }
}

void setScale(uint8_t container, float value) {
  switch (container) {
    case 1: cfg.scale1 = value; break;
    case 2: cfg.scale2 = value; break;
    case 3: cfg.scale3 = value; break;
  }
}

String uint64ToString(uint64_t value) {
  char buf[32];
  snprintf(buf, sizeof(buf), "%llu", (unsigned long long)value);
  return String(buf);
}

// ============================================================
// EEPROM
// ============================================================
void saveConfig() {
  EEPROM.put(0, cfg);
  EEPROM.commit();
  Serial.println(F("Config saved"));
}

void loadConfig() {
  EEPROM.begin(EEPROM_SIZE);
  EEPROM.get(0, cfg);

  if (cfg.magic != EEPROM_MAGIC) {
    Serial.println(F("No valid config. Using defaults."));
    cfg.magic = EEPROM_MAGIC;
    cfg.scale1 = 1000.0f;
    cfg.scale2 = 1000.0f;
    cfg.scale3 = 1000.0f;
    cfg.offset1 = 0L;
    cfg.offset2 = 0L;
    cfg.offset3 = 0L;
    saveConfig();
  } else {
    Serial.println(F("Saved config loaded"));
  }
}

// ============================================================
// HX711 SAFE READ
// ============================================================
bool waitReadyTimeout(HX711 &hx, unsigned long timeoutMs) {
  unsigned long t0 = millis();
  while (!hx.is_ready()) {
    if (millis() - t0 >= timeoutMs) return false;
    delay(1);
  }
  return true;
}

bool readAverageRawTimeout(HX711 &hx, int samples, long &outAvg) {
  long total = 0;
  for (int i = 0; i < samples; i++) {
    if (!waitReadyTimeout(hx, HX_READY_TIMEOUT_MS)) return false;
    total += hx.read();
  }
  outAvg = total / samples;
  return true;
}

bool getWeightTimeout(uint8_t container, int samples, float &outWeight) {
  HX711 *hx = getLoadCell(container);
  if (!hx) return false;

  long rawAvg = 0;
  if (!readAverageRawTimeout(*hx, samples, rawAvg)) return false;

  float scale = getScale(container);
  long offset = getOffset(container);
  if (scale == 0.0f) return false;

  outWeight = (rawAvg - offset) / scale;
  return true;
}


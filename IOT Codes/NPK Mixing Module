    false, false, false,
    0, 0, 0,
    status,
    outDocId
  );
}

// ============================================================
// OPTION 9 HELPERS
// ============================================================
float mlToGrams(uint8_t container, float ml) {
  float d = 1.0f;
  if (container == 1) d = DENSITY1_G_PER_ML;
  else if (container == 2) d = DENSITY2_G_PER_ML;
  else if (container == 3) d = DENSITY3_G_PER_ML;
  return ml * d;
}

struct PumpCtl {
  bool enabled = false;
  bool done = false;
  bool pumpOn = false;
  unsigned long nextSwitch = 0;
  unsigned long startMs = 0;
  unsigned long lastGoodMs = 0;
  float startW = 0;
  float lastW = 0;
};

// ============================================================
// STOP COMMAND DETECTION
// ============================================================
bool pollPendingStopCommand(DeviceCommand &outStopCmd) {
  DeviceCommand cmd;
  if (!fetchDeviceCommand(cmd)) return false;
  if (!cmd.exists) return false;
  if (cmd.commandId.length() == 0) return false;
  if (cmd.commandId == gLastHandledCommandId) return false;
  if (cmd.status != "PENDING") return false;
  if (cmd.type != "stop_all") return false;

  outStopCmd = cmd;
  return true;
}

// ============================================================
// OPTION 9: DISPENSE ALL 3 SIMULTANEOUSLY
// C3 forced = C2
// LC3 ignored for control
// Pump2 + Pump3 controlled by LC2
// ============================================================
void dispenseAllSimultaneousML(float ml1,
                               float ml2,
                               float ml3_user,
                               String &outFinalStatus,
                               String &outLogId,
                               bool &outStoppedByCloudCommand,
                               DeviceCommand &outStopCommand) {
  outFinalStatus = "FAILED";
  outLogId = "";
  outStoppedByCloudCommand = false;
  outStopCommand = DeviceCommand();

  float ml3 = ml2;
  float target1_g = mlToGrams(1, ml1);
  float target2_g = mlToGrams(2, ml2);

  float startW1 = 0, startW2 = 0, startW3 = 0;
  float endW1 = 0, endW2 = 0, endW3 = 0;

  bool startOk1 = getWeightTimeout(1, START_READ_SAMPLES, startW1);
  bool startOk2 = getWeightTimeout(2, START_READ_SAMPLES, startW2);
  bool startOk3 = getWeightTimeout(3, START_READ_SAMPLES, startW3);

  Serial.println();
  Serial.println(F("=========== SIMULTANEOUS DOSE ==========="));
  Serial.print(F("Input mL: C1=")); Serial.print(ml1, 2);
  Serial.print(F(" C2=")); Serial.print(ml2, 2);
  Serial.print(F(" C3=")); Serial.print(ml3_user, 2);
  Serial.println(F(" (C3 forced = C2)"));

  Serial.print(F("Used mL: C1=")); Serial.print(ml1, 2);
  Serial.print(F(" C2=")); Serial.print(ml2, 2);
  Serial.print(F(" C3=")); Serial.print(ml3, 2);
  Serial.println();

  Serial.print(F("Target g: C1=")); Serial.print(target1_g, 2);
  Serial.print(F(" C2=")); Serial.print(target2_g, 2);
  Serial.println(F(" (C3 controlled by LC2)"));

  Serial.println(F("Type X to emergency stop."));
  Serial.println(F("========================================="));

  PumpCtl c1, c23;
  c1.enabled = (target1_g >= MIN_TRANSFER_G);
  c23.enabled = (target2_g >= MIN_TRANSFER_G);

  if (!c1.enabled && !c23.enabled) {
    Serial.println(F("All requested amounts too small"));

    bool endOk1 = getWeightTimeout(1, READ_SAMPLES, endW1);
    bool endOk2 = getWeightTimeout(2, READ_SAMPLES, endW2);
    bool endOk3 = getWeightTimeout(3, READ_SAMPLES, endW3);

    String logId;
    bool ok = addDispenseLogToFirestore(
      ml1, ml2, ml3_user, ml3,
      target1_g, target2_g,
      startOk1, startOk2, startOk3,
      startW1, startW2, startW3,
      endOk1, endOk2, endOk3,
      endW1, endW2, endW3,
      "SKIPPED_TOO_SMALL",
      logId
    );

    outFinalStatus = "SKIPPED_TOO_SMALL";
    if (ok) outLogId = logId;
    return;
  }

  if (c1.enabled) {
    float w;
    if (!getWeightTimeout(1, START_READ_SAMPLES, w)) {
      Serial.println(F("C1 start read failed -> skip C1"));
      c1.enabled = false;
    } else {
      c1.startW = c1.lastW = w;
      c1.startMs = c1.lastGoodMs = millis();
    }
  }

  if (c23.enabled) {
    float w;
    if (!getWeightTimeout(2, START_READ_SAMPLES, w)) {
      Serial.println(F("C2 start read failed -> skip C2+C3"));
      c23.enabled = false;
    } else {
      c23.startW = c23.lastW = w;
      c23.startMs = c23.lastGoodMs = millis();
    }
  }

  if (!c1.enabled && !c23.enabled) {
    Serial.println(F("No usable channels"));

    bool endOk1 = getWeightTimeout(1, READ_SAMPLES, endW1);
    bool endOk2 = getWeightTimeout(2, READ_SAMPLES, endW2);
    bool endOk3 = getWeightTimeout(3, READ_SAMPLES, endW3);

    String logId;
    bool ok = addDispenseLogToFirestore(
      ml1, ml2, ml3_user, ml3,
      target1_g, target2_g,
      startOk1, startOk2, startOk3,
      startW1, startW2, startW3,
      endOk1, endOk2, endOk3,
      endW1, endW2, endW3,
      "FAILED_NO_CHANNEL",
      logId
    );

    outFinalStatus = "FAILED_NO_CHANNEL";
    if (ok) outLogId = logId;
    return;
  }

  if (c1.enabled) outputOn(SOL1_PIN);
  if (c23.enabled) {
    outputOn(SOL2_PIN);
    outputOn(SOL3_PIN);
  }
  delay(150);

  setPump1(false);
  setPump23(false);

  unsigned long lastPrint = 0;
  unsigned long lastStopPollMs = 0;
  unsigned long lastBusyHeartbeatMs = 0;
  String finalStatus = "DONE";

  while (true) {
    unsigned long now = millis();

    // Keep status fresh while dispensing so app still sees device online
    if (now - lastBusyHeartbeatMs >= BUSY_STATUS_HEARTBEAT_MS) {
      lastBusyHeartbeatMs = now;
      gDeviceBusy = true;
      gDeviceState = "DISPENSING";
      updateDeviceStatusDocument();
      gLastHeartbeatMs = now;
    }

    if (now - lastStopPollMs >= STOP_COMMAND_POLL_INTERVAL_MS) {
      lastStopPollMs = now;

      DeviceCommand stopCmd;
      if (pollPendingStopCommand(stopCmd)) {
        Serial.println(F("[Cloud] stop_all detected during dispense"));

        stopCmd.status = "RUNNING";
        stopCmd.startedAt = makeUtcTimestamp();
        stopCmd.lastUpdatedAt = stopCmd.startedAt;

        updateDeviceCommandDocument(stopCmd);
        gLastHandledCommandId = stopCmd.commandId;

        outStoppedByCloudCommand = true;
        outStopCommand = stopCmd;

        stopAllOutputs();
        finalStatus = "STOPPED_BY_COMMAND";
        break;
      }
    }

    if (Serial.available()) {
      char ch = Serial.peek();
      if (ch == 'x' || ch == 'X') {
        Serial.read();
        stopAllOutputs();
        finalStatus = "EMERGENCY_STOP";
        Serial.println(F("EMERGENCY STOP"));
        break;
      }
    }

    float disp1 = 0, rem1 = 0;
    if (c1.enabled && !c1.done) {
      float w;
      if (getWeightTimeout(1, READ_SAMPLES, w)) {
        c1.lastW = w;
        c1.lastGoodMs = now;
      } else {
        setPump1(false);
      }

      if (now - c1.lastGoodMs > HX_LOST_MAX_MS) {
        Serial.println(F("C1 sensor lost"));
        c1.done = true;
        setPump1(false);
        outputOff(SOL1_PIN);
        finalStatus = "SENSOR_LOST_C1";
      } else if (!c1.done) {
        disp1 = c1.startW - c1.lastW;
        rem1 = target1_g - disp1;

        if (disp1 >= target1_g) {
          c1.done = true;
          setPump1(false);
          outputOff(SOL1_PIN);
          Serial.println(F("C1 done"));
        } else if (now - c1.startMs > TRANSFER_TIMEOUT_MS) {
          c1.done = true;
          setPump1(false);
          outputOff(SOL1_PIN);
          Serial.println(F("C1 timeout"));
          finalStatus = "TIMEOUT_C1";
        } else {
          unsigned long onMs, offMs;
          if (rem1 > SLOW_REGION_G) {
            onMs = FAST_ON_MS;
            offMs = FAST_OFF_MS;
          } else {
            onMs = PULSE_ON_MS;
            offMs = PULSE_OFF_MS;
          }

          if (now >= c1.nextSwitch) {
            c1.pumpOn = !c1.pumpOn;
            setPump1(c1.pumpOn);
            c1.nextSwitch = now + (c1.pumpOn ? onMs : offMs);
          }
        }
      }
    } else {
      setPump1(false);
    }

    float disp2 = 0, rem2 = 0;
    if (c23.enabled && !c23.done) {
      float w;
      if (getWeightTimeout(2, READ_SAMPLES, w)) {
        c23.lastW = w;
        c23.lastGoodMs = now;
      } else {
        setPump23(false);
      }

      if (now - c23.lastGoodMs > HX_LOST_MAX_MS) {
        Serial.println(F("C2 sensor lost"));
        c23.done = true;
        setPump23(false);
        outputOff(SOL2_PIN);
        outputOff(SOL3_PIN);
        finalStatus = "SENSOR_LOST_C2";
      } else if (!c23.done) {
        disp2 = c23.startW - c23.lastW;
        rem2 = target2_g - disp2;

        if (disp2 >= target2_g) {
          c23.done = true;
          setPump23(false);
          outputOff(SOL2_PIN);
          outputOff(SOL3_PIN);
          Serial.println(F("C2+C3 done"));
        } else if (now - c23.startMs > TRANSFER_TIMEOUT_MS) {
          c23.done = true;
          setPump23(false);
          outputOff(SOL2_PIN);
          outputOff(SOL3_PIN);
          Serial.println(F("C2+C3 timeout"));
          finalStatus = "TIMEOUT_C2_C3";
        } else {
          unsigned long onMs, offMs;
          if (rem2 > SLOW_REGION_G) {
            onMs = FAST_ON_MS;
            offMs = FAST_OFF_MS;
          } else {
            onMs = PULSE_ON_MS;
            offMs = PULSE_OFF_MS;
          }

          if (now >= c23.nextSwitch) {
            c23.pumpOn = !c23.pumpOn;
            setPump23(c23.pumpOn);
            c23.nextSwitch = now + (c23.pumpOn ? onMs : offMs);
          }
        }
      }
    } else {
      setPump23(false);
    }

    if (now - lastPrint >= STATUS_PRINT_MS) {
      lastPrint = now;
      Serial.print(F("[ALL] "));
      if (c1.enabled) {
        Serial.print(F("C1 disp=")); Serial.print(disp1, 2);
        Serial.print(F("g rem=")); Serial.print(rem1, 2);
        Serial.print(F("g | "));
      } else {
        Serial.print(F("C1 SKIP | "));
      }

      if (c23.enabled) {
        Serial.print(F("C2 disp=")); Serial.print(disp2, 2);
        Serial.print(F("g rem=")); Serial.print(rem2, 2);
        Serial.print(F("g | C3 mirrors C2"));
      } else {
        Serial.print(F("C2+C3 SKIP"));
      }
      Serial.println();
    }

    bool done1 = (!c1.enabled) || c1.done;
    bool done2 = (!c23.enabled) || c23.done;
    if (done1 && done2) break;

    delay(5);
  }

  stopAllOutputs();
  Serial.println(F("========== ALL DONE =========="));

  bool endOk1 = getWeightTimeout(1, READ_SAMPLES, endW1);
  bool endOk2 = getWeightTimeout(2, READ_SAMPLES, endW2);
  bool endOk3 = getWeightTimeout(3, READ_SAMPLES, endW3);

  String logId;
  bool ok = addDispenseLogToFirestore(
    ml1, ml2, ml3_user, ml3,
    target1_g, target2_g,
    startOk1, startOk2, startOk3,
    startW1, startW2, startW3,
    endOk1, endOk2, endOk3,
    endW1, endW2, endW3,
    finalStatus,
    logId
  );

  outFinalStatus = finalStatus;
  if (ok) outLogId = logId;
}

// ============================================================
// EXECUTION WRAPPERS
// ============================================================
RunResult runDispenseJob(float ml1,
                         float ml2,
                         float ml3User,
                         const String &commandId) {
  RunResult result;

  gDeviceBusy = true;
  gDeviceState = "DISPENSING";
  gLastCommandId = commandId;
  updateDeviceStatusDocument();
  gLastHeartbeatMs = millis();

  bool stoppedByCloudCommand = false;
  DeviceCommand stopCmd;

  dispenseAllSimultaneousML(
    ml1,
    ml2,
    ml3User,
    result.finalStatus,
    result.logId,
    stoppedByCloudCommand,
    stopCmd
  );

  gDeviceBusy = false;
  gDeviceState = "IDLE";
  gLastExecutionStatus = result.finalStatus;

  if (result.logId.length()) {
    gLastLogId = result.logId;
  }

  if (stoppedByCloudCommand) {
    gLastCommandId = stopCmd.commandId;

    stopCmd.status = "DONE";
    stopCmd.executionStatus = result.finalStatus;
    stopCmd.completedAt = makeUtcTimestamp();
    stopCmd.lastUpdatedAt = stopCmd.completedAt;
    stopCmd.lastLogId = result.logId;

    updateDeviceCommandDocument(stopCmd);
    result.commandDocHandled = true;
  }

  updateDeviceStatusDocument();
  gLastHeartbeatMs = millis();
  return result;
}

RunResult runStopAllCommand(const String &commandId) {
  RunResult result;
  result.finalStatus = "STOPPED_BY_COMMAND";

  stopAllOutputs();

  gDeviceBusy = false;
  gDeviceState = "IDLE";
  gLastCommandId = commandId;
  gLastExecutionStatus = result.finalStatus;

  String logId;
  if (addStopLogToFirestore(result.finalStatus, logId)) {
    result.logId = logId;
    gLastLogId = logId;
  }

  updateDeviceStatusDocument();
  gLastHeartbeatMs = millis();
  return result;
}

// ============================================================
// CLOUD COMMAND HANDLER
// ============================================================
void pollAndHandleCloudCommand() {
  DeviceCommand cmd;
  if (!fetchDeviceCommand(cmd)) return;
  if (!cmd.exists) return;
  if (cmd.status != "PENDING") return;
  if (cmd.commandId.length() == 0) return;
  if (cmd.commandId == gLastHandledCommandId) return;

  Serial.println();
  Serial.println(F("[Cloud] New pending command detected"));
  Serial.print(F("[Cloud] commandId: "));
  Serial.println(cmd.commandId);
  Serial.print(F("[Cloud] type: "));
  Serial.println(cmd.type);

  if (cmd.type == "stop_all") {
    cmd.status = "RUNNING";
    cmd.startedAt = makeUtcTimestamp();
    cmd.lastUpdatedAt = cmd.startedAt;

    if (!updateDeviceCommandDocument(cmd)) {
      Serial.println(F("[Cloud] Failed to mark stop command RUNNING"));
      return;
    }

    gLastHandledCommandId = cmd.commandId;

    RunResult result = runStopAllCommand(cmd.commandId);

    cmd.status = "DONE";
    cmd.executionStatus = result.finalStatus;
    cmd.completedAt = makeUtcTimestamp();
    cmd.lastUpdatedAt = cmd.completedAt;
    cmd.lastLogId = result.logId;

    if (updateDeviceCommandDocument(cmd)) {
      Serial.println(F("[Cloud] Stop command updated after execution"));
    } else {
      Serial.println(F("[Cloud] Failed to update stop command after execution"));
    }
    return;
  }

  if (gDeviceBusy) return;

  if (cmd.type != "dispense_all") {
    Serial.println(F("[Cloud] Unsupported command type"));

    cmd.status = "FAILED";
    cmd.executionStatus = "UNSUPPORTED_TYPE";
    cmd.lastUpdatedAt = makeUtcTimestamp();
    cmd.completedAt = cmd.lastUpdatedAt;
    cmd.lastLogId = "";

    updateDeviceCommandDocument(cmd);

    gLastHandledCommandId = cmd.commandId;
    gLastCommandId = cmd.commandId;
    gLastExecutionStatus = "UNSUPPORTED_TYPE";
    updateDeviceStatusDocument();
    gLastHeartbeatMs = millis();
    return;
  }

  cmd.status = "RUNNING";
  cmd.startedAt = makeUtcTimestamp();
  cmd.lastUpdatedAt = cmd.startedAt;

  if (!updateDeviceCommandDocument(cmd)) {
    Serial.println(F("[Cloud] Failed to mark command RUNNING"));
    return;
  }

  gLastHandledCommandId = cmd.commandId;

  RunResult result = runDispenseJob(cmd.c1ml, cmd.c2ml, cmd.c3ml, cmd.commandId);

  if (result.commandDocHandled) {
    Serial.println(F("[Cloud] Command doc already handled by stop_all"));
    return;
  }

  cmd.status = (result.finalStatus == "DONE") ? "DONE" : "FAILED";
  cmd.executionStatus = result.finalStatus;
  cmd.completedAt = makeUtcTimestamp();
  cmd.lastUpdatedAt = cmd.completedAt;
  cmd.lastLogId = result.logId;

  if (updateDeviceCommandDocument(cmd)) {
    Serial.println(F("[Cloud] Command updated after execution"));
  } else {
    Serial.println(F("[Cloud] Failed to update command after execution"));
  }
}


// ============================================================
// TARE / CALIBRATE
// ============================================================
void tareContainer(uint8_t container) {
  HX711 *hx = getLoadCell(container);
  if (!hx) {
    Serial.println(F("Invalid container"));
    return;
  }

  long rawAvg = 0;
  if (!readAverageRawTimeout(*hx, TARE_SAMPLES, rawAvg)) {
    Serial.println(F("Load cell not ready"));
    return;
  }

  setOffset(container, rawAvg);
  saveConfig();

  Serial.print(F("Container "));
  Serial.print(container);
  Serial.println(F(" tared"));
}

void tareAll() {
  tareContainer(1);
  tareContainer(2);
  tareContainer(3);
}

void calibrateContainer(uint8_t container, float knownWeightG) {
  HX711 *hx = getLoadCell(container);
  if (!hx) {
    Serial.println(F("Invalid container"));
    return;
  }

  if (knownWeightG == 0.0f) {
    Serial.println(F("Known weight must not be zero"));
    return;
  }

  long rawAvg = 0;
  if (!readAverageRawTimeout(*hx, CAL_SAMPLES, rawAvg)) {
    Serial.println(F("Load cell not ready"));
    return;
  }

  long rawDiff = rawAvg - getOffset(container);
  float newScale = (float)rawDiff / knownWeightG;

  if (newScale == 0.0f || isnan(newScale) || isinf(newScale)) {
    Serial.println(F("Calibration failed"));
    return;
  }

  setScale(container, newScale);
  saveConfig();

  Serial.print(F("New scale = "));
  Serial.println(newScale, 6);
}

